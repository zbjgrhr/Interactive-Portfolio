  "projects": [
    {
      "id": "pixel-seed",
      "title": "Pixel World",
      "oneLiner": "Write a world once; ten agents turn it into a reviewed, beautifully generated, locally saved game you can play and take home.",
      "context": "Pixel World carries a maker's premise through a visible ten-agent studio, cross-reviewed GameSpec V3, multi-provider generation, a bright adaptive product interface, a custom playable runtime, local persistence, and offline delivery.",
      "problem": "A free-form idea has to become one coherent game—story, mechanics, art direction, assets, levels, audio, runtime rules, save state, and export—without hiding cost, failure, or creative decisions from the maker.",
      "role": "Independent product ownership and full-stack implementation across multi-agent orchestration, provider routing, GameSpec and review contracts, asset pipelines, interaction design, the custom 2D runtime, persistence, export, and deployment.",
      "process": [
        "Capture the premise, levels, and constraints, then complete GameSpec V3 without overwriting the creator's intent",
        "Run ten specialist agents, cross-review their proposals, and require creator approval before generation",
        "Choose among eight image routes and three Agent platforms, then lock one visual model per project",
        "Generate editable level-aware asset queues in parallel and retry only failed work",
        "Replace the default product hero with the generated game's own cover",
        "Play, save, reload, and export the complete game as an offline ZIP"
      ],
      "keyDecisions": [
        "Separate planning models from image models while locking one visual model per project for consistency",
        "Treat agent outputs as proposals under creator approval",
        "Keep agent runs and asset tasks independently retryable",
        "Make every asset, level assignment, runtime constraint, and QA recommendation inspectable",
        "Let each generated world's cover replace the default product hero",
        "Use playability, local persistence, and offline export as the final proof of quality"
      ],
      "technology": [
        "Next.js 15",
        "React 19",
        "TypeScript",
        "Ant Design",
        "Zustand",
        "Multi-agent orchestration",
        "GameSpec V3",
        "OpenRouter",
        "OpenAI",
        "Alibaba DashScope",
        "Cloudflare Workers AI",
        "FLUX.2 Klein 4B",
        "IndexedDB",
        "Web Audio",
        "Custom 2D runtime"
      ],
      "challenges": [
        "Keeping ten specialist agents aligned without hiding the process",
        "Preserving explicit creator decisions while agents fill gaps and validate engine constraints",
        "Normalizing provider credentials, regions, pricing, and response formats",
        "Maintaining visual consistency while preserving item-level retry and level assignment",
        "Keeping the generated game stable after save, load, and ZIP export"
      ],
      "outcome": "A live prompt-to-game product that moves from an approved premise to a reviewed specification, recoverable generation plan, adaptive product cover, playable campaign, local save, and downloadable offline game. Darabangba is one generated example; the same system supports creator-defined level counts, structures, objectives, and play styles.",
      "learned": [
        "Multi-agent systems become useful when responsibility, review order, failure, and creator approval are visible",
        "Model choice is a product decision involving style, cost, region, and recovery",
        "Constraints become creative controls when the maker can inspect, approve, and retry them",
        "The product itself can come alive when the generated world's cover becomes its interface",
        "A generated world is complete only when it survives play, local persistence, and delivery"
      ],
      "coverSrc": "/portfolio/pixel-world-v5-platform-overview.png",
