  "projects": [
    {
      "id": "pixel-seed",
      "title": "Pixel World",
      "oneLiner": "A prompt becomes a cross-reviewed GameSpec, a governed production pipeline, and a playable pixel game that can ship.",
      "context": "Pixel World now combines multi-provider model access, a ten-agent creative studio, GameSpec V3, creator approval, governed asset production, runtime validation, and offline export in one continuous product.",
      "problem": "A free-form idea has to become a coherent story, mechanics, art direction, level plan, runtime-safe assets, and testable rules without hiding cost, failure, or creative decisions from the maker.",
      "role": "Independent product ownership and full-stack implementation across multi-agent orchestration, provider routing, GameSpec and review contracts, asset pipelines, interaction design, the custom 2D runtime, persistence, export, and deployment.",
      "process": [
        "Capture the premise and constraints, then complete GameSpec V3 without overwriting the creator's intent",
        "Run ten specialist agents across direction, narrative, mechanics, art, levels, integration, consistency, engine QA, revision, and asset coordination",
        "Cross-review the specification and require creator approval before image generation begins",
        "Lock one image model per project and execute editable, recoverable asset queues",
        "Assign assets per level, test the rules in the custom runtime, save locally, and export an offline ZIP"
      ],
      "keyDecisions": [
        "Separate planning models from image models while locking one visual model per project for consistency",
        "Treat agent outputs as proposals under creator approval",
        "Keep agent runs and asset tasks independently retryable",
        "Make every asset, level assignment, runtime constraint, and QA recommendation inspectable",
        "Use playability, persistence, and offline export as the final proof of quality"
      ],
      "technology": [
        "Next.js 15",
        "React 19",
        "TypeScript",
        "Ant Design",
        "Zustand",
        "Multi-agent orchestration",
        "GameSpec V3",
        "OpenRouter",
        "OpenAI",
        "Alibaba DashScope",
        "Cloudflare Workers AI",
        "FLUX.2 Klein 4B",
        "IndexedDB",
        "Web Audio",
        "Custom 2D runtime"
      ],
      "challenges": [
        "Keeping ten specialist agents aligned without hiding the process",
        "Preserving explicit creator decisions while agents fill gaps and validate engine constraints",
        "Normalizing provider credentials, regions, pricing, and response formats",
        "Maintaining visual consistency while preserving item-level retry and level assignment",
        "Keeping the generated game stable after save, load, and ZIP export"
      ],
      "outcome": "A live multi-agent game creation product that moves from an approved brief to a reviewable GameSpec, governed asset system, playable campaign, local save, and offline package. The Darabangba project demonstrates a two-level inverted fairy tale with melee, ranged combat, and a final boss.",
      "learned": [
        "Multi-agent systems become useful when responsibility, review order, failure, and creator approval are visible",
        "Model choice is a product decision involving style, cost, region, and recovery",
        "Constraints become creative controls when the maker can inspect, approve, and retry them",
        "A generated world is complete only when it survives play, persistence, and delivery"
      ],
      "coverSrc": "/portfolio/pixel-world-v4-generated-world.png",
